# ================================================================
# Supabase (프론트에 노출되는 클라이언트 키)
# 이 파일을 .env.local 로 복사해서 실제 값 채우기.
# .env.local 은 .gitignore 처리되어 GitHub에 안 올라감.
# ================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key...

# ================================================================
# 서버 전용 (Telegram + OpenAI 파이프라인)
# 절대 NEXT_PUBLIC_ 붙이지 말 것! 프론트에 노출됨.
# ================================================================
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...관리자키
OPENAI_API_KEY=sk-proj-...
TELEGRAM_BOT_TOKEN=1234567890:AA...
# Telegram이 webhook 호출할 때 헤더에 붙일 비밀 문자열 (아무 문자열이나 길게, 예: openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=change-me-to-random-32-char-string
# 허용된 Telegram 사용자 ID 리스트 (콤마 구분). @userinfobot 으로 확인.
TELEGRAM_ALLOWED_USER_IDS=123456789
